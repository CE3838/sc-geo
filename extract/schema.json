{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CE3838/sc-geo/extract/schema.json",
  "title": "One document's extraction, written by the reading model",
  "description": "Every value is an object with the value as stated, the page it is on, a short verbatim quote from that page, and whether it was inferred. A field the source does not give is omitted or written as the string \"not stated\". The model never assigns confidence; sc-geo computes it at ingest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "units", "observations", "structures", "groundwater", "references"],
  "properties": {
    "schema_version": {"const": 1},
    "source_id": {"type": "string", "minLength": 1, "description": "Catalog id, e.g. ngmdb:10009"},
    "packets": {"type": "array", "items": {"type": "string"}, "description": "Packet files read for this result"},
    "reader": {"type": "string", "description": "Who read it (model and session), free text"},
    "notes": {"type": "string", "maxLength": 2000, "description": "Anything the reader wants a reviewer to know"},
    "units": {"type": "array", "items": {"$ref": "#/$defs/unit"}},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "structures": {"type": "array", "items": {"$ref": "#/$defs/structure"}},
    "groundwater": {"type": "array", "items": {"$ref": "#/$defs/groundwater"}},
    "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "surfaces": {"type": "array", "items": {"$ref": "#/$defs/surface"}, "description": "Optional. Elevation or depth of the top or base of a unit at one place"},
    "contours": {"type": "array", "items": {"$ref": "#/$defs/contour"}, "description": "Optional. Structure-contour and isopach maps"},
    "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}, "description": "Optional. Published cross sections"}
  },
  "$defs": {
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "page", "quote", "inferred"],
      "properties": {
        "value": {"type": ["string", "number", "boolean", "null"], "description": "As stated in the source, in the source's own words and units"},
        "page": {"type": "integer", "minimum": 1, "description": "Page number as labelled in the packet (=== PAGE n ===)"},
        "quote": {"type": "string", "minLength": 1, "maxLength": 400, "description": "Short verbatim text from that page that shows the value"},
        "inferred": {"type": "boolean", "description": "true when the value was reasoned out rather than read directly"},
        "units": {"type": "string", "maxLength": 40, "description": "Measurement units when stated separately from the value (e.g. a table header)"},
        "table": {"type": "boolean", "description": "true when read from a table or log"},
        "note": {"type": "string", "maxLength": 300}
      }
    },
    "field": {"anyOf": [{"$ref": "#/$defs/value"}, {"const": "not stated"}]},
    "elevation_field": {
      "description": "An elevation or depth: a number or the text as printed; units given separately are ft or m",
      "anyOf": [{"allOf": [{"$ref": "#/$defs/value"},
                           {"properties": {"value": {"type": ["number", "string"]}, "units": {"enum": ["ft", "m"]}}}]},
                {"const": "not stated"}]
    },
    "boundary_field": {
      "description": "Which boundary of the unit the surface is",
      "anyOf": [{"allOf": [{"$ref": "#/$defs/value"}, {"properties": {"value": {"enum": ["top", "base"]}}}]},
                {"const": "not stated"}]
    },
    "surface_method_field": {
      "description": "Measured in a boring or well, read from a contour map, interpolated between points, or stated in text",
      "anyOf": [{"allOf": [{"$ref": "#/$defs/value"},
                           {"properties": {"value": {"enum": ["measured", "contour", "interpolated", "stated"]}}}]},
                {"const": "not stated"}]
    },
    "depth_reference_field": {
      "description": "Whether interval tops and bottoms are depths below land surface or elevations",
      "anyOf": [{"allOf": [{"$ref": "#/$defs/value"}, {"properties": {"value": {"enum": ["land surface", "elevation"]}}}]},
                {"const": "not stated"}]
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "map_symbol": {"$ref": "#/$defs/field"},
        "name": {"$ref": "#/$defs/field"},
        "rank": {"$ref": "#/$defs/field"},
        "group": {"$ref": "#/$defs/field"},
        "age": {"$ref": "#/$defs/field"},
        "description": {"$ref": "#/$defs/field"},
        "lithology": {"$ref": "#/$defs/field"},
        "thickness": {"$ref": "#/$defs/field"},
        "contacts": {"$ref": "#/$defs/field"},
        "depositional_environment": {"$ref": "#/$defs/field"},
        "fossils": {"$ref": "#/$defs/field"}
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": {"$ref": "#/$defs/field"},
        "bottom": {"$ref": "#/$defs/field"},
        "unit": {"$ref": "#/$defs/field"},
        "description": {"$ref": "#/$defs/field"},
        "uscs": {"$ref": "#/$defs/field"},
        "munsell": {"$ref": "#/$defs/field"},
        "spt_n": {"$ref": "#/$defs/field"},
        "liquid_limit": {"$ref": "#/$defs/field"},
        "plasticity_index": {"$ref": "#/$defs/field"},
        "moisture_content": {"$ref": "#/$defs/field"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["boring", "well", "outcrop", "auger_hole", "core", "test_pit", "cpt", "other"]},
        "label": {"$ref": "#/$defs/field"},
        "location": {"$ref": "#/$defs/field"},
        "elevation": {"$ref": "#/$defs/field"},
        "datum": {"$ref": "#/$defs/field", "description": "Vertical datum of the elevation, as printed"},
        "depth_reference": {"$ref": "#/$defs/depth_reference_field"},
        "total_depth": {"$ref": "#/$defs/field"},
        "date": {"$ref": "#/$defs/field"},
        "intervals": {"type": "array", "items": {"$ref": "#/$defs/interval"}},
        "water_level": {"$ref": "#/$defs/field"},
        "water_level_date": {"$ref": "#/$defs/field"}
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["fault", "fold", "joint", "bedding", "foliation", "lineation", "lineament", "contact", "other"]},
        "name": {"$ref": "#/$defs/field"},
        "fault_type": {"$ref": "#/$defs/field"},
        "sense": {"$ref": "#/$defs/field"},
        "certainty": {"$ref": "#/$defs/field"},
        "strike_dip": {"$ref": "#/$defs/field"},
        "location": {"$ref": "#/$defs/field"},
        "age": {"$ref": "#/$defs/field"},
        "description": {"$ref": "#/$defs/field"}
      }
    },
    "groundwater": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aquifer": {"$ref": "#/$defs/field"},
        "role": {"$ref": "#/$defs/field"},
        "unit": {"$ref": "#/$defs/field"},
        "head": {"$ref": "#/$defs/field"},
        "location": {"$ref": "#/$defs/field"},
        "date": {"$ref": "#/$defs/field"},
        "transmissivity": {"$ref": "#/$defs/field"},
        "hydraulic_conductivity": {"$ref": "#/$defs/field"},
        "description": {"$ref": "#/$defs/field"}
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surface": {"$ref": "#/$defs/field"},
        "unit": {"$ref": "#/$defs/field"},
        "boundary": {"$ref": "#/$defs/boundary_field"},
        "elevation": {"$ref": "#/$defs/elevation_field"},
        "depth": {"$ref": "#/$defs/elevation_field", "description": "Below land surface, instead of an elevation"},
        "datum": {"$ref": "#/$defs/field", "description": "As printed: NGVD 29, NAVD 88, sea level, land surface..."},
        "location": {"$ref": "#/$defs/field"},
        "observation": {"$ref": "#/$defs/field", "description": "Label of a boring or well in this result"},
        "method": {"$ref": "#/$defs/surface_method_field"}
      }
    },
    "contour": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["structure", "isopach"]},
        "surface": {"$ref": "#/$defs/field"},
        "unit": {"$ref": "#/$defs/field"},
        "interval": {"$ref": "#/$defs/field"},
        "datum": {"$ref": "#/$defs/field"},
        "units": {"$ref": "#/$defs/field"},
        "area": {"$ref": "#/$defs/field"},
        "values": {"type": "array", "items": {"$ref": "#/$defs/value"}, "description": "Contour labels read, where legible"},
        "figure": {"$ref": "#/$defs/field"}
      }
    },
    "section_end": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "location": {"$ref": "#/$defs/field"},
        "coordinates": {"$ref": "#/$defs/field"}
      }
    },
    "section_unit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": {"$ref": "#/$defs/field"},
        "from_distance": {"$ref": "#/$defs/field"},
        "to_distance": {"$ref": "#/$defs/field"},
        "top_elevation": {"$ref": "#/$defs/elevation_field"},
        "base_elevation": {"$ref": "#/$defs/elevation_field"}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/field"},
        "figure": {"$ref": "#/$defs/field"},
        "start": {"$ref": "#/$defs/section_end"},
        "end": {"$ref": "#/$defs/section_end"},
        "vertical_exaggeration": {"$ref": "#/$defs/field"},
        "datum": {"$ref": "#/$defs/field"},
        "length": {"$ref": "#/$defs/field"},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/value"}, "description": "Labels of borings and wells shown"},
        "units_along": {"type": "array", "items": {"$ref": "#/$defs/section_unit"}}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation"],
      "properties": {"citation": {"$ref": "#/$defs/field"}}
    }
  }
}
